{
	"config": {
		"platform": {
			"php": "8.3"
		},
		"apcu-autoloader": true,
		"allow-plugins": {
			"yogarine/doctrine-annotation-autoload": true
		}
	},
	"name": "poblaciones/services",
	"description": "Plataforma abierta de datos espaciales de población",
	"license": "GNU GLP v3",
	"type": "project",
	"require": {
		"php": ">=8.3.0",
		"symfony/http-foundation": "^5.4",
		"symfony/routing": "^5.4",
		"symfony/serializer": "^5.4",
		"symfony/property-info": "^5.4",
		"symfony/property-access": "^5.4",
		"symfony/error-handler": "^5.4",
		"symfony/cache": "^5.4",
		"symfony/http-kernel": "^5.4",
		"twig/twig": "^3.0",
		"mobiledetect/mobiledetectlib": "^2.8",
		"sendgrid/sendgrid": "^7.0",
		"defuse/php-encryption": "^2.2",
		"phpmailer/phpmailer": "^6.0",
		"geoip2/geoip2": "^2.9",
		"doctrine/dbal": "^3.10",
		"doctrine/orm": "^2.19",
		"doctrine/annotations": "^1.14",
		"jms/serializer": "^3.0",
		"jms/metadata": "^2.6.0",
		"yogarine/doctrine-annotation-autoload": "^0.3.0",
		"rodrigoq/lusitanian-oauth": "^2.0",
		"gasparesganga/php-shapefile": "^3.1",
		"mpdf/mpdf": "^8.2",
		"phpoffice/phpspreadsheet": "^1.29",
		"openspout/openspout": "^4.0",
		"rodrigoq/phpmailersendgrid": "^1.0",
		"ezyang/htmlpurifier": "^4.13",
		"rodrigoq/simple-html-dom": "^1.5",
		"proj4php/proj4php": "^2.0",
		"longitude-one/doctrine-spatial": "^5.0"
	},
	"autoload": {
		"psr-0": {
			"": "src/"
		},
		"psr-4": {
			"helena\\": "src/",
			"export\\": "EXPORT/",
			"minga\\framework\\": "src/framework/src/"
		},
		"files": [
			"vendor/rodrigoq/simple-html-dom/simple_html_dom_base.php"
		]
	},
	"extra": {
		"branch-alias": {
			"dev-master": "2.0.x-dev"
		}
	},
	"scripts": {
		"run": [
			"echo 'Started web server on http://localhost:8888'",
			"php -S localhost:8888 -t web"
		]
	},
	"require-dev": {
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^9.6"
	}
}
